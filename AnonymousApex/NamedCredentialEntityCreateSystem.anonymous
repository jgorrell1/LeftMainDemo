// System Account - POST to entities endpoint
HttpRequest req = new HttpRequest();
req.setEndpoint('callout:Insights_API/salesforce/api/entities');
req.setMethod('POST');
req.setHeader('Content-Type', 'application/json');
req.setHeader('Accept', 'application/json');
req.setTimeout(60000);

// JSON body
String jsonBody = '{"concreteEntityType":"IndividualEntity",' +
  '"notes":"Test Notes",' +
  '"concreteEntityAttributes":' +
    '{"firstName":"A E New",' +
    '"middleName":null,' +
    '"lastName":"Hennings",' +
    '"birthDate":"1950-05-01",' +
    '"deathDate":"2025-05-07"},' +
 '"phoneNumbersAttributes":' +
   '[' +
    '{"number":"9721234567",' +
      '"primary":true},' +
    '{"number":"2141234567",' +
      '"primary":false}' +
  '],' +
'"emailAddressesAttributes":' +
  '[' +
    '{"email":"primaryTester@tester.com",' +
     '"primary":true},' +
    '{"email":"backuptester@tester.com",' +
     '"primary":false}' +
  '],' +
  '"addressesAttributes":' +
    '[' +
        '{"streetAddress":"123 Somewhere Road",' +
         '"city":"Portola",' +
         '"state":"CA",' +
         '"zipCode":"96122",' +
         '"primary":true},' +
        '{"streetAddress":"456 Nowhere Lane",' +
         '"city":"Athens",' +
         '"state":"GA",' +
         '"zipCode":"30601",' +
         '"primary":false}' +
    ']' +
'}';

req.setBody(jsonBody);

System.debug('Testing Insights API POST to /entities...');
System.debug('User: ' + UserInfo.getUserEmail());
System.debug('Body: ' + jsonBody);

try {
    Http http = new Http();
    HttpResponse res = http.send(req);
    
    System.debug('✅ Status: ' + res.getStatusCode());
    System.debug('Response: ' + res.getBody());
    
} catch (Exception e) {
    System.debug('❌ Error: ' + e.getMessage());
}